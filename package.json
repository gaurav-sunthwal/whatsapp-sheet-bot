{
  "name": "whatsapp-sheet-bot",
  "version": "1.0.0",
  "description": "Auto-extract Mahadiscom beneficiary data from WhatsApp screenshots → CSV",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/run.js",
    "start:app": "electron .",
    "bot": "node index.js",
    "setup": "node setup.js",
    "extractor": "cd python && .venv/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8765",
    "extractor:install": "cd python && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "qrcode": "^1.5.4"
  }
}
